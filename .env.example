# New ASHER runtime. Keep dry-run enabled until permissions and physical
# verification are complete.
ASHER_OWNER_NAME=YourName
ASHER_DRY_RUN=true
# ASHER_RUNTIME_DIR=C:\Users\YourName\AppData\Local\Asher

# Local models
ASHER_OLLAMA_URL=http://127.0.0.1:11434
# Remote Ollama endpoints are rejected unless this is explicitly enabled.
# ASHER_ALLOW_REMOTE_OLLAMA=false
ASHER_OLLAMA_MODEL=qwen3:4b
ASHER_WHISPER_MODEL=small.en
ASHER_WHISPER_DEVICE=auto
ASHER_WHISPER_COMPUTE_TYPE=auto

# Optional OpenAI providers. Never commit the real key.
OPENAI_API_KEY=
ASHER_OPENAI_ROUTINE_MODEL=gpt-5.6-luna
ASHER_OPENAI_REASONING_MODEL=gpt-5.6-terra
ASHER_OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
ASHER_OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional microphone index. Run: python voice_diagnostics.py
# ASHER_MIC_INDEX=0

# Voice output profile: asher_male or asher_female.
ASHER_VOICE_PROFILE=asher_male
